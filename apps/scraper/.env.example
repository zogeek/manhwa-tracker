# Copier en `.env` (ignoré par git). Variables du worker préfixées par SCRAPER_ (sauf celles de `search`, en fin de fichier).

# Origine de l'API Hono (sans /api/ingest).
SCRAPER_API_URL=http://localhost:3001
# Même valeur que SCRAPER_API_KEY dans apps/api/.env.development (>= 32 caractères, `openssl rand -hex 32`).
SCRAPER_API_KEY=change-me-with-openssl-rand-hex-32-output-000000

# Navigateur anti-détection (Camoufox) sans fenêtre ; `false` pour observer un challenge anti-bot en local.
SCRAPER_HEADLESS=true
# Délai max d'une page, challenge anti-bot compris (ms).
SCRAPER_PAGE_TIMEOUT_MS=45000
# Politesse : intervalle minimal entre deux requêtes vers un même site (s).
SCRAPER_REQUEST_INTERVAL_S=1.5
# Œuvres par lot envoyé à /api/ingest/batches (1–100).
SCRAPER_BATCH_SIZE=20
SCRAPER_LOG_LEVEL=INFO

# Commande `search` uniquement (variables non préfixées).
# Instance SearXNG auto-hébergée, moteur prioritaire (format JSON activé dans son settings.yml).
SEARXNG_URL=http://localhost:8080
# Repli inactif par défaut : clé de l'API Brave Search (compte requis), lue seulement si SEARXNG_URL est vide.
BRAVE_SEARCH_API_KEY=
