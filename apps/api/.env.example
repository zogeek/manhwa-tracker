# Copier en `.env.development` (dev) ou `.env.production` (prod). Ces fichiers sont ignorés par git.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:dev_password@localhost:5431/manhwa_dev

# Better Auth
# Secret de signature des sessions (>= 32 caractères) : `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32-output
# URL publique vue par le navigateur. Avec le proxy Next.js (`/api/auth/*` -> Hono), c'est l'origine du front.
BETTER_AUTH_URL=http://localhost:3000

# Clé d'API machine-à-machine du scraper Python (header `x-api-key` sur /api/ingest/*), >= 32 caractères.
# Générer avec : openssl rand -hex 32 — la même valeur est à donner au worker, jamais au front.
SCRAPER_API_KEY=change-me-with-openssl-rand-hex-32-output-000000

# Catalogue externe (recherche de repli + import) : API GraphQL publique d'AniList, sans clé.
ANILIST_API_URL=https://graphql.anilist.co

# Proxy d'images (/images/proxy?url=…) : domaines autorisés, sous-domaines inclus, séparés par des virgules.
# Ajouter ici les CDN des sources de scantrad dont on veut servir les couvertures.
IMAGE_PROXY_ALLOWED_HOSTS=anilist.co,mangadex.org,kitsu.app,kitsu.io

# Origines autorisées (séparées par des virgules) : CORS + trustedOrigins de Better Auth.
CORS_ORIGINS=http://localhost:3000

# Catalogues externes activés (recherche de repli + import), par ordre de priorité : anilist, mangadex, kitsu.
DISCOVERY_PROVIDERS=anilist,mangadex,kitsu
# API REST publique de MangaDex (sans clé) : catalogue + flux de chapitres.
MANGADEX_API_URL=https://api.mangadex.org
# Langues des chapitres synchronisés depuis MangaDex après un import (codes MangaDex, ex. fr,en,pt-br).
MANGADEX_CHAPTER_LANGUAGES=fr,en
# API JSON:API publique de Kitsu (sans clé) : catalogue. Couvertures servies par media.kitsu.app.
KITSU_API_URL=https://kitsu.app/api/edge

# Médias copiés localement (couvertures miroir, servies par /images/media/:key). Répertoire ignoré par git.
MEDIA_STORAGE_DIR=./storage/media

# Worker de tâches de fond (table `jobs`) intégré à l'API. Plusieurs instances peuvent tourner : SKIP LOCKED.
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=2000
JOBS_BATCH_SIZE=5
