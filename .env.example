# Variables de docker-compose.yml (stack Docker complète). Copier en `.env` à la racine (ignoré par git).
# Le développement local hors Docker garde ses fichiers : apps/api/.env.development et apps/scraper/.env.

# ── Postgres ───────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=manhwa
# Caractères sûrs dans une URL (openssl rand -hex 24) : le mot de passe est inséré tel quel dans DATABASE_URL.
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24
POSTGRES_DB=manhwa

# ── API ────────────────────────────────────────────────────────────────────────────────────────────────
# Port publié sur 127.0.0.1 uniquement.
API_PORT=3001
# Secret de signature des sessions (>= 32 caractères) : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32-output
# URL publique vue par le navigateur (origine du front Next.js, qui proxifie /api/auth/*).
BETTER_AUTH_URL=http://localhost:3000
# Origines autorisées (CORS + trustedOrigins), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000
IMAGE_PROXY_ALLOWED_HOSTS=anilist.co,mangadex.org,kitsu.app,kitsu.io

# Clé de service partagée API ↔ scraper (header x-api-key), >= 32 caractères : openssl rand -hex 32
SCRAPER_API_KEY=change-me-with-openssl-rand-hex-32-output-000000

# ── SearXNG ────────────────────────────────────────────────────────────────────────────────────────────
# Clé secrète de l'instance : openssl rand -hex 32
SEARXNG_SECRET=change-me-with-openssl-rand-hex-32

# ── Scraper (planification) ────────────────────────────────────────────────────────────────────────────
# Sources suivies, `slug=uuid` séparés par des virgules. UUID : GET /sources sur l'API. Vide : le worker attend.
# Ex. : SCRAPER_TRACK_TARGETS=mangas-origines=<uuid>,scan-manga=<uuid>
SCRAPER_TRACK_TARGETS=
# Cadence : un cycle (toutes les sources, l'une après l'autre) toutes les N secondes. 7200 = 2 h.
SCRAPER_SCHEDULE_INTERVAL_S=7200
# Durée max d'un run : au-delà, il est interrompu (puis tué 30 s plus tard s'il ne répond pas).
SCRAPER_RUN_TIMEOUT_S=3600
# Politesse : intervalle minimal entre deux requêtes vers un même site (s).
SCRAPER_REQUEST_INTERVAL_S=1.5
SCRAPER_LOG_LEVEL=INFO
